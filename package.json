{
  "name": "hermes-chat",
  "displayName": "Hermes Chat",
  "description": "Embeds the official DeepSeek Harness web UI (same interface as the desktop app) inside VS Code, running on Windows or WSL.",
  "version": "0.2.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:hermesChatView",
    "onCommand:hermesChat.open",
    "onCommand:hermesChat.configure",
    "onCommand:hermesChat.restart",
    "onCommand:hermesChat.openInBrowser"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hermesChat.open",
        "title": "Hermes: Open Chat"
      },
      {
        "command": "hermesChat.configure",
        "title": "Hermes: Configure Harness"
      },
      {
        "command": "hermesChat.restart",
        "title": "Hermes: Restart Harness Runtime"
      },
      {
        "command": "hermesChat.openInBrowser",
        "title": "Hermes: Open in Browser"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hermes",
          "title": "Hermes",
          "icon": "media/hermes.svg"
        }
      ]
    },
    "views": {
      "hermes": [
        {
          "id": "hermesChatView",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Hermes Chat",
      "properties": {
        "hermesChat.runtime": {
          "type": "string",
          "enum": [
            "auto",
            "wsl",
            "windows"
          ],
          "default": "auto",
          "description": "Where to launch the official DeepSeek Harness web runtime."
        },
        "hermesChat.wslDistribution": {
          "type": "string",
          "default": "",
          "description": "WSL distribution name. Empty uses the default distribution."
        },
        "hermesChat.dshPath": {
          "type": "string",
          "default": "",
          "description": "Path or command for the official dsh executable inside the selected runtime. Empty uses dsh on PATH."
        },
        "hermesChat.webPort": {
          "type": "number",
          "default": 0,
          "description": "Fixed port for the Harness web runtime. 0 lets the OS pick a free port."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.0",
    "@vscode/vsce": "^3.2.1"
  }
}

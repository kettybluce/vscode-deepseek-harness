{
  "name": "hermes-embed",
  "displayName": "Hermes Embed（内嵌实验）",
  "description": "实验分支：把 DeepSeek Harness 的完整 Web 界面内嵌到 VS Code 编辑器区。与正式版 Hermes Chat 并存的独立扩展，互不覆盖。",
  "version": "0.5.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:hermesEmbedLauncher",
    "onCommand:hermesEmbed.open",
    "onCommand:hermesEmbed.openInBrowser",
    "onCommand:hermesEmbed.copyAddress",
    "onCommand:hermesEmbed.launch",
    "onCommand:hermesEmbed.stop",
    "onCommand:hermesEmbed.configure"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hermesEmbed.open",
        "title": "Hermes Embed: 在 VS Code 内嵌打开"
      },
      {
        "command": "hermesEmbed.launch",
        "title": "Hermes Embed: 启动运行时"
      },
      {
        "command": "hermesEmbed.stop",
        "title": "Hermes Embed: 停止本扩展启动的运行时"
      },
      {
        "command": "hermesEmbed.openInBrowser",
        "title": "Hermes Embed: 在浏览器打开"
      },
      {
        "command": "hermesEmbed.copyAddress",
        "title": "Hermes Embed: 复制固定地址"
      },
      {
        "command": "hermesEmbed.configure",
        "title": "Hermes Embed: 设置"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hermesEmbed",
          "title": "Hermes Embed",
          "icon": "media/hermes.svg"
        }
      ]
    },
    "views": {
      "hermesEmbed": [
        {
          "id": "hermesEmbedLauncher",
          "name": "内嵌承载（实验）"
        }
      ]
    },
    "configuration": {
      "title": "Hermes Embed（实验）",
      "properties": {
        "hermesEmbed.webPort": {
          "type": "number",
          "default": 18431,
          "description": "目标 dsh web 端口。默认与正式版 Hermes Chat 相同（18431），以便直接附着到已在运行的运行时；检测到已有实例时本扩展不会重复启动。"
        },
        "hermesEmbed.webHost": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "dsh web 绑定地址。保持 127.0.0.1（WSL2 localhost 转发直达 Windows）。"
        },
        "hermesEmbed.proxyPort": {
          "type": "number",
          "default": 18432,
          "description": "内嵌承载用的本地反向代理端口。只监听 127.0.0.1，仅用于给内嵌窗口补齐认证，不改变浏览器侧行为。0 = 系统随机分配。"
        },
        "hermesEmbed.runtime": {
          "type": "string",
          "enum": [
            "auto",
            "wsl",
            "windows"
          ],
          "default": "auto",
          "description": "在哪里运行 dsh web：Windows 宿主经 wsl.exe，或本机（Remote-WSL 扩展宿主）。"
        },
        "hermesEmbed.wslDistribution": {
          "type": "string",
          "default": "",
          "description": "WSL 发行版名。留空使用默认发行版。"
        },
        "hermesEmbed.dshPath": {
          "type": "string",
          "default": "",
          "description": "dsh 路径（运行时侧视角）。留空自动探测：PATH 里的 dsh，或 ~/.nvm/versions/node/*/bin/dsh 中最新版本。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.0",
    "@vscode/vsce": "^3.2.1"
  }
}

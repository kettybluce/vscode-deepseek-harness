{
  "name": "hermes-chat",
  "displayName": "Hermes Chat",
  "description": "Codex-style VS Code client for the official DeepSeek Harness running on Windows or WSL.",
  "version": "0.1.1",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:hermesChatView",
    "onCommand:hermesChat.open",
    "onCommand:hermesChat.configure",
    "onCommand:hermesChat.explainSelection"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hermesChat.open",
        "title": "Hermes: Open Chat"
      },
      {
        "command": "hermesChat.configure",
        "title": "Hermes: Configure Harness"
      },
      {
        "command": "hermesChat.explainSelection",
        "title": "Hermes: Explain Selection"
      },
      {
        "command": "hermesChat.openTerminal",
        "title": "Hermes: Open Terminal"
      },
      {
        "command": "hermesChat.checkUpdates",
        "title": "Hermes: Check Harness Runtime"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "hermesChat.explainSelection",
          "when": "editorTextFocus",
          "group": "hermes@1"
        }
      ],
      "commandPalette": [
        {
          "command": "hermesChat.explainSelection",
          "when": "editorTextFocus"
        },
        {
          "command": "hermesChat.openTerminal"
        },
        {
          "command": "hermesChat.checkUpdates"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hermes",
          "title": "Hermes",
          "icon": "media/hermes.svg"
        }
      ]
    },
    "views": {
      "hermes": [
        {
          "id": "hermesChatView",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Hermes Chat",
      "properties": {
        "hermesChat.runtime": {
          "type": "string",
          "enum": [
            "auto",
            "wsl",
            "windows"
          ],
          "default": "auto",
          "description": "Where to launch the official DeepSeek Harness."
        },
        "hermesChat.wslDistribution": {
          "type": "string",
          "default": "",
          "description": "WSL distribution name. Empty uses the default distribution."
        },
        "hermesChat.dshPath": {
          "type": "string",
          "default": "",
          "description": "Path or command for the official dsh executable inside the selected runtime. Empty uses dsh on PATH."
        },
        "hermesChat.dshArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "--profile",
            "sdk"
          ],
          "description": "Arguments passed to dsh. The default starts the official SDK JSON-RPC stdio bridge."
        },
        "hermesChat.autoUpdate": {
          "type": "boolean",
          "default": false,
          "description": "Check for Harness updates, but never replace a working runtime without confirmation."
        },
        "hermesChat.endpoint": {
          "type": "string",
          "default": "",
          "description": "Optional legacy OpenAI-compatible endpoint. Used only when no dsh process is configured."
        },
        "hermesChat.apiKey": {
          "type": "string",
          "default": "",
          "description": "Optional API key.",
          "scope": "machine-overridable"
        },
        "hermesChat.model": {
          "type": "string",
          "default": "deepseek-v4-flash",
          "description": "Model identifier sent to the official Harness provider route."
        },
        "hermesChat.provider": {
          "type": "string",
          "default": "deepseek-official",
          "description": "Harness provider route used during initialize."
        },
        "hermesChat.reasoningEffort": {
          "type": "string",
          "default": "",
          "description": "Optional Harness reasoning effort (for example low, medium, high, or max)."
        },
        "hermesChat.systemPrompt": {
          "type": "string",
          "default": "You are a helpful coding assistant. Be concise, show safe commands, and explain changes before applying them.",
          "description": "Default system prompt."
        },
        "hermesChat.temperature": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 2
        },
        "hermesChat.maxTokens": {
          "type": "number",
          "default": 4096,
          "minimum": 128,
          "maximum": 32768
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.0",
    "@vscode/vsce": "^3.2.1"
  }
}
